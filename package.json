{
  "name": "slack-emoji-uploader",
  "version": "2.0.0",
  "private": true,
  "description": "Chrome extension that adds any image on the web to Slack as a custom emoji",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "zip": "npm run build && cd dist && zip -qr ../slack-emoji-uploader.zip ."
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "gifuct-js": "^2.1.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "gifenc": "^1.0.3"
  }
}
